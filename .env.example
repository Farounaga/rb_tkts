# Zendesk
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_SUBDOMAIN=
# Optionnel : ajouter automatiquement le suffixe /token
ZENDESK_ADD_TOKEN_SUFFIX=true

# Ollama (LOCAL)
OLLAMA_BASE_URL=http://localhost:11434
# IMPORTANT : modèle local pour vectorisation
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
# IMPORTANT : modèle local pour nommage/résumé des topics
OLLAMA_LLM_MODEL=llama3.2:1b-instruct
# Optionnel : liste explicite des modèles à télécharger automatiquement au démarrage
# (séparer par des virgules)
OLLAMA_MODELS=
# true = démarre `ollama serve` + `ollama pull` automatiquement si nécessaire
OLLAMA_AUTO_START=true
OLLAMA_START_TIMEOUT=30
# true = arrête ollama en fin de run (uniquement si lancé automatiquement par le script)
OLLAMA_AUTO_STOP=true
OLLAMA_STOP_TIMEOUT=10
# true = ne bloque pas le pipeline si Ollama est indisponible (WSL, service arrêté, etc.)
SKIP_OLLAMA_ON_ERROR=true
# En WSL avec Ollama lancé côté Windows, utiliser souvent:
# OLLAMA_AUTO_START=false

# Base NoSQL XML (BaseX REST)
XML_DB_ENABLED=false
XML_DB_BASE_URL=http://xml-db:8984
XML_DB_USER=admin
XML_DB_PASSWORD=admin
XML_DB_DATABASE=ticketsdb
XML_DB_RESOURCE=tickets.xml
# true = importe le XML local dans la base si la ressource n'existe pas encore
XML_DB_IMPORT_ON_START=true
# cache local utilisé par le pipeline après lecture depuis la base XML
XML_DB_LOCAL_CACHE=tmp/tickets_from_xml_db.xml

# Docker frontend
FRONTEND_PORT=18080

# Pipeline
TICKETS_XML_PATH=../mesvaccinshelp-20250211/tickets.xml
EMBEDDINGS_OUTPUT=embeddings.json
CLUSTERS_OUTPUT=clusters.json
CLUSTER_TOPICS_OUTPUT=cluster_topics.json
HTML_REPORT_OUTPUT=output/visualisation.html
KMEANS_K=10
EMBEDDING_THREADS=4
# Protection anti "input length exceeds the context length"
# (tronque automatiquement les tickets trop longs avant /api/embeddings)
EMBEDDING_MAX_CHARS=12000
# Limite optionnelle pour run de test rapide (ex: 100 ou 300)
MAX_TICKETS=
# Timeouts Ollama (secondes)
OLLAMA_OPEN_TIMEOUT=5
OLLAMA_READ_TIMEOUT=180
# Backoff de retry (secondes)
OLLAMA_RETRY_BASE_DELAY=0.5
# Timeouts/retries spécifiques à la génération des topics de clusters
TOPIC_OPEN_TIMEOUT=5
TOPIC_READ_TIMEOUT=180
TOPIC_MAX_RETRIES=3
TOPIC_RETRY_BASE_DELAY=0.5
# Réglages vitesse/stabilité pour les titres de cluster
TOPIC_NUM_PREDICT=32
TOPIC_TEMPERATURE=0.2
RUN_EMBEDDINGS=true
RUN_CLUSTERING=true
RUN_CLUSTER_TOPICS=true
SIMILAR_TICKETS_OUTPUT=similar_tickets.json
CLUSTERING_METRICS_OUTPUT=clustering_metrics.json
RUN_CLUSTERING_METRICS=true
RUN_SIMILARITY=true
SIMILARITY_TOP_K=5
SIMILARITY_THRESHOLD=0.80
RUN_EXPORT_CSV=true
CSV_EXPORT_OUTPUT=output/tickets_summary.csv
